---
import '../styles/global.css';
import settings from '../content/settings.json';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = settings.seo.title, description = settings.seo.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = settings.seo.ogImage ? new URL(url(settings.seo.ogImage), Astro.site).href : '';

// Шрифти з макета: Helvetica Neue (Thin, Light, Regular, Italic) і Carl Brown.
// Файли (HelveticaNeueCyr з кирилицею) лежать у public/fonts.
const fonts = [
  { family: 'Helvetica Neue', weight: 100, style: 'normal', file: 'HelveticaNeue-Thin' },
  { family: 'Helvetica Neue', weight: 300, style: 'normal', file: 'HelveticaNeue-Light' },
  { family: 'Helvetica Neue', weight: 400, style: 'normal', file: 'HelveticaNeue-Regular' },
  { family: 'Helvetica Neue', weight: 400, style: 'italic', file: 'HelveticaNeue-Italic' },
  { family: 'Carl Brown', weight: 400, style: 'normal', file: 'CarlBrown-Regular' },
];
const fontFaces = fonts
  .map(
    (f) => `@font-face{font-family:'${f.family}';font-weight:${f.weight};font-style:${f.style};font-display:swap;src:url('${url(`fonts/${f.file}.woff2`)}') format('woff2');}`
  )
  .join('');
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Картинка й опис, коли посилання на сайт надсилають у месенджер чи соцмережу -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Фавікон з UI-кіта Figma («Favicon» 32 і 192): MÉ золотом на темному -->
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('favicon-192.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="theme-color" content="#101711" />

    <!-- Шрифти з макета: Helvetica Neue і Carl Brown (файли — у public/fonts) -->
    <style is:inline set:html={fontFaces}></style>
    <!-- усі шрифти потрібні на першому екрані: вантажимо одразу, разом зі стилями (швидший LCP) -->
    {fonts.map((f) => <link rel="preload" href={url(`fonts/${f.file}.woff2`)} as="font" type="font/woff2" crossorigin />)}
    <slot name="head" />
  </head>
  <body style={`--noise:url(${url('images/noise.webp')})`}>
    <slot />
    <div class="cursor" data-cursor aria-hidden="true">
      <span class="cursor__glow"></span>
      <span class="cursor__dot"></span>
    </div>
    <script>
      import '../scripts/animations.js';
      import '../scripts/interactive.js';
    </script>
  </body>
</html>
