---
// Блок 2 — перехід після скважини (Figma «Продовження»: шапка 13:313, фото 13:278; моб 57:1172, 57:1171).
// Рендериться всередині «липкого» першого екрана (Block1). Анімація — data-b2-* в animations.js.
import home from '../content/home.json';
import settings from '../content/settings.json';
import { url } from '../lib/url';
const { slides } = home.transition;
const { nav } = settings.header;
const { phone, email } = settings.contacts;
---
<div class="b2-slides" data-b2-slides>
  {slides.map((s, i) => (
    <picture class="b2-slide" data-b2-slide>
      <source media="(max-width: 767px)" srcset={url(s.imageMobile)} />
      <img src={url(s.image)} alt="" width="1920" height="1080" fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
    </picture>
  ))}
</div>
<span class="b2-final" data-b2-final aria-hidden="true"></span>

<span class="b2-logo" data-b2-logo aria-hidden="true"></span>

<header class="b2-header" data-b2-header>
  <nav class="b2-nav" aria-label="Головне меню">
    {nav.map((l) => <a class="ui-link" href={l.href}>{l.label}</a>)}
  </nav>
  <a class="b2-header__slot" href={url('/')} aria-label="На головну" data-b2-logo-slot></a>
  <div class="b2-contacts">
    <a class="ui-link ui-link--accent" href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
    <a class="ui-link ui-link--accent" href={`mailto:${email}`}>{email}</a>
  </div>
</header>

<style>
  /* Фото інтер'єрів: стопка на весь екран, наприкінці зменшується до рамки з макета */
  /* центр через inset + margin: auto (без translate — фото обертається в 3D через GSAP) */
  .b2-slides {
    position: absolute; inset: 0; margin: auto;
    width: 100%; height: 100%; overflow: hidden; z-index: 1;
  }
  .b2-slide, .b2-slide img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .b2-slide + .b2-slide { opacity: 0; }

  /* Кінцевий розмір фото (невидимий, з нього бере розмір анімація) */
  .b2-final {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    width: calc(234 * var(--s)); height: calc(437 * var(--s));
    visibility: hidden; pointer-events: none;
  }

  /* Логотип під скважиною: стоїть по центру, потім летить у шапку */
  .b2-logo {
    --logo-w: calc(var(--kh-h) * 16 / 9 * 33 / 1244);
    --logo-h: var(--logo-w);
    position: absolute; left: 50%; top: 50%; z-index: 2;
    width: var(--logo-w); height: var(--logo-h);
    margin: calc(var(--logo-h) / -2) 0 0 calc(var(--logo-w) / -2);
    background: var(--color-beige);
    mask: var(--mask-m) center / contain no-repeat;
  }

  /* Шапка: з'являється під скважиною (як у Framer) — спершу її видно крізь отвір */
  .b2-header {
    position: absolute; left: 0; right: 0; top: 0; z-index: 2;
    height: calc(70 * var(--s)); padding-inline: calc(var(--grid-offset) * var(--s));
    font-size: calc(var(--hero-text) * var(--s)); line-height: 1; text-transform: uppercase;
    opacity: 0; visibility: hidden;
  }
  .b2-header__slot {
    position: absolute; left: 50%; top: calc(20 * var(--s)); translate: -50% 0;
    width: calc(33 * var(--s)); height: calc(33 * var(--s));
  }
  .b2-nav, .b2-contacts { display: none; }

  @media (min-width: 768px) {
    /* Рамка фото — з 3-ї по 14-ту колонку сітки (12 колонок + 11 проміжків), пропорція макета 912:513 */
    .b2-final {
      --gut: calc(var(--grid-gutter) * var(--s));
      --col-w: calc((100vw - 2 * var(--grid-offset) * var(--s) - (var(--grid-cols) - 1) * var(--gut)) / var(--grid-cols));
      width: calc(12 * var(--col-w) + 11 * var(--gut));
      height: calc((12 * var(--col-w) + 11 * var(--gut)) * 513 / 912);
    }
    .b2-logo {
      --logo-w: calc(var(--kh-h) * 16 / 9 * 51 / 1440);
      --logo-h: calc(var(--logo-w) * 49 / 51);
      mask-image: var(--mask-d);
    }
    .b2-header__slot { top: calc(21 * var(--s)); width: calc(51 * var(--s)); height: calc(49 * var(--s)); }

    .b2-nav, .b2-contacts {
      display: flex; gap: calc(33 * var(--s));
      position: absolute; top: calc(38 * var(--s));
    }
    .b2-nav { left: calc(var(--grid-offset) * var(--s)); }
    .b2-contacts { right: calc(var(--grid-offset) * var(--s)); }
  }
</style>
